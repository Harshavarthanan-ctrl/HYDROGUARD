# ==============================
# HydroGuard AI - Git Ignore
# ==============================

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/

# Environment / secrets
.env
.env.*
!.env.example

# Jupyter
.ipynb_checkpoints/

# Data
data/raw/*
data/processed/*
data/external/*

# Keep data directories
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# Machine Learning artifacts
models/*
*.pkl
*.pickle
*.joblib
*.h5
*.keras
*.pt
*.pth

# Logs
*.log
logs/

# Node
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp

# Coverage / testing
.coverage
htmlcov/
.pytest_cache/

# Ruff / tooling
.ruff_cache/
.mypy_cache/